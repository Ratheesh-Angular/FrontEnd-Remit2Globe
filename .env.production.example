# Production template — copy to `.env.production` only on your machine for local builds.
# On Render / Vercel, set the same variable names in the project dashboard.

NEXT_PUBLIC_API_URL=https://amigo-api-uwm5.onrender.com/api

# Server-side BFF + sync-session: prefer internal URL (private network), else public API root.
# BACKEND_INTERNAL_API_URL=http://YOUR_API_INTERNAL_HOST:PORT/api
BACKEND_API_URL=https://amigo-api-uwm5.onrender.com/api

# Same value as on the backend service — exchanges NextAuth OAuth users for mirrored `token` on the Next origin.
INTERNAL_FRONTEND_AUTH_SECRET="<long-random-string-match-backend>"

NEXTAUTH_URL=https://amigo-web.onrender.com
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-in-local-env-local-if-needed


GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxx-a.<REGION>-postgres.render.com/DATABASE?sslmode=require"
