# Production template — copy to `.env.production` only on your machine for local builds.
# On Render / Vercel, set the same variable names in the project dashboard.

NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api

NEXTAUTH_URL=https://your-frontend.onrender.com
NEXTAUTH_SECRET="<openssl rand -base64 32>"

GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxx-a.<REGION>-postgres.render.com/DATABASE?sslmode=require"
