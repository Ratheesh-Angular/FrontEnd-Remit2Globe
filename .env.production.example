# Production template — copy to `.env.production` only on your machine for local builds.
# On Render, Vercel, or EC2/PM2, set the same variable names in the host environment (not committed).

# Public API root (browser). Usually https://YOUR_API_DOMAIN/api — must NOT point at the Next.js host.
NEXT_PUBLIC_API_URL=https://your-api.example.com/api

# Flex bank list (`/api/flex/banks/...`) may be unreachable when the provider IP-whitelists callers.
NEXT_PUBLIC_ENABLE_FLEX_BANK_LIST=false

# Server-side BFF + sync-session: on AWS, prefer a private URL so Route Handlers call the backend over the VPC.
# Example (same EC2): BACKEND_INTERNAL_API_URL=http://127.0.0.1:8000/api
# Example (separate EC2): BACKEND_INTERNAL_API_URL=http://10.0.1.50:8000/api
# Fallback when unset: BACKEND_API_URL (often the public https://…/api).
BACKEND_INTERNAL_API_URL=
BACKEND_API_URL=https://your-api.example.com/api

# Same value as cbp-backend — exchanges NextAuth OAuth users for mirrored `token` on the Next origin.
INTERNAL_FRONTEND_AUTH_SECRET="<long-random-string-match-backend>"

# Must match the public URL users open (load balancer / domain). Required for OAuth callbacks.
NEXTAUTH_URL=https://your-web.example.com
NEXTAUTH_SECRET="<generate-a-strong-secret>"

GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

# NextAuth @auth/pg-adapter + JWT callbacks read the same Postgres as the backend (`"User"` table, etc.).
# RDS security group must allow this host (Next EC2 or container) on the DB port.
DATABASE_URL="postgresql://USER:PASSWORD@your-rds-host.region.rds.amazonaws.com:5432/your_db"

