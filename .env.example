# Frontend env layout — see `docs/ENVIRONMENT.md` at repo root.

# Files (Next.js):
# - `.env.development` — local defaults (`npm run dev`)
# - `.env.production.example` — copy to `.env.production` for local prod builds only
# - `.env.local` / `.env.development.local` — overrides (gitignored)
#
# After changing NEXT_PUBLIC_* vars, restart `npm run dev` so the dev server picks them up.

NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-only: BFF `/api/backend/*` + sync-session (optional locally; required in production on the host).
# Prefer internal URL on Render — see docs/ENVIRONMENT.md
# BACKEND_INTERNAL_API_URL=http://api-service:8080/api
BACKEND_API_URL=http://localhost:8000/api

# Shared with cbp-backend: Next.js exchanges NextAuth sessions for Express JWT cookies (trusted internal route).
INTERNAL_FRONTEND_AUTH_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATABASE_URL="postgresql://postgres:R2GRdsDataBase%21@payment-app-db.cbquq8k0028m.eu-west-1.rds.amazonaws.com:5432/payment_db"

