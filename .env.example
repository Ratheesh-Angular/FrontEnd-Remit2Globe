# Copy to `.env` and fill in values. `NEXT_PUBLIC_*` is exposed to the browser.
# Server-side backend base URL resolution (BFF, RSC, sync-session):
#   BACKEND_INTERNAL_API_URL → BACKEND_API_URL → NEXT_PUBLIC_API_URL

# --- Public (bundled into client) ---
NEXT_PUBLIC_API_URL=
# Canonical public site URL (optional; helps catch API URL pointing at this host in prod)
NEXT_PUBLIC_SITE_URL=
# Set to "false" to disable flex bank list in add-beneficiary (default: enabled)
NEXT_PUBLIC_ENABLE_FLEX_BANK_LIST=

# --- Server-only: upstream API ---
BACKEND_INTERNAL_API_URL=
BACKEND_API_URL=

# --- Auth ---
# Cookie `Secure` flag: defaults to true only when NEXTAUTH_URL uses https://. On http:// (e.g. raw EC2 IP) leave
# unset, or set COOKIE_SECURE=false. Set COOKIE_SECURE=true behind HTTPS / reverse proxy with TLS.
# COOKIE_SECURE=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTERNAL_FRONTEND_AUTH_SECRET=

# --- Database (NextAuth adapter + app User rows) ---
DATABASE_URL=
