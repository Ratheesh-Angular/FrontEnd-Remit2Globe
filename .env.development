# Next.js loads this when running `next dev` (NODE_ENV=development)

NEXT_PUBLIC_API_URL=http://localhost:5000/api

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-in-local-env-local-if-needed

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Same DB as backend for NextAuth adapter (local Postgres)
DATABASE_URL="postgresql://postgres:12345@localhost:5432/cbp_db"
